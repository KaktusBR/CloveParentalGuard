<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 exposes the Windows.UI.Notifications toast API (no extra package). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CloveParentalGuard</AssemblyName>
    <RootNamespace>CloveParentalGuard.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single-file / self-contained flags are passed at publish time
         (see install/Build-CloveParentalGuard.ps1) so plain build & test stay fast. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloveParentalGuard.Core\CloveParentalGuard.Core.csproj" />
  </ItemGroup>

</Project>
